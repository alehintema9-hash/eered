  async function compressCover(file){
    if(!file)return '';
    if(!file.type.startsWith('image/'))throw new Error('Выбери файл изображения.');
    if(file.size>12*1024*1024)throw new Error('Исходная картинка должна быть меньше 12 МБ.');
    let bitmap;
    try{bitmap=await createImageBitmap(file);}catch{throw new Error('Не удалось открыть изображение. Попробуй JPG или PNG.');}
    const maxDim=1000, scale=Math.min(1,maxDim/Math.max(bitmap.width,bitmap.height));
    const canvas=document.createElement('canvas');canvas.width=Math.max(1,Math.round(bitmap.width*scale));canvas.height=Math.max(1,Math.round(bitmap.height*scale));
    const ctx=canvas.getContext('2d');ctx.fillStyle='#111';ctx.fillRect(0,0,canvas.width,canvas.height);ctx.drawImage(bitmap,0,0,canvas.width,canvas.height);bitmap.close?.();
    let quality=.78, blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));
    while(blob && blob.size>280*1024 && quality>.4){quality-=.08;blob=await new Promise(resolve=>canvas.toBlob(resolve,'image/jpeg',quality));}
    if(!blob||blob.size>300*1024)throw new Error('Не удалось сжать обложку до 300 КБ. Выбери картинку поменьше.');
    return await new Promise((resolve,reject)=>{const r=new FileReader();r.onload=()=>resolve(String(r.result));r.onerror=()=>reject(new Error('Не удалось прочитать изображение.'));r.readAsDataURL(blob);});
  }
  $('trackForm').addEventListener('submit',async e=>{e.preventDefault();if(!db||!isOwner||!auth.currentUser||auth.currentUser.email.toLowerCase()!==OWNER_EMAIL.toLowerCase()){showNotice('formNotice','Только владелец может публиковать треки.','error');return;}const btn=$('saveBtn');btn.disabled=true;btn.textContent='СОХРАНЯЕМ…';try{
    let coverUrl=safeURL($('coverUrl').value.trim())||'';let coverData=editingCoverData;
    const file=$('coverFile').files[0];if(file){coverData=await compressCover(file);coverUrl='';}else if(coverUrl){coverData='';}
    const payload={title:$('title').value.trim(),artist:$('artist').value.trim(),release_name:$('releaseName').value.trim()||$('title').value.trim(),cover_url:coverUrl,cover_data:coverData,youtube_url:safeURL($('youtubeUrl').value.trim())||'',spotify_url:safeURL($('spotifyUrl').value.trim())||'',other_url:safeURL($('otherUrl').value.trim())||'',other_label:$('otherLabel').value.trim()||'',lyrics:$('lyrics').value.trim()};
    if(!payload.title||!payload.artist||!payload.lyrics)throw new Error('Заполни название, исполнителя и текст.');if(payload.lyrics.length>60000)throw new Error('Текст слишком длинный (максимум 60 000 символов).');
    const id=$('editId').value;if(id){payload.created_at=tracks.find(t=>t.id===id)?.created_at||firebase.firestore.FieldValue.serverTimestamp();payload.updated_at=firebase.firestore.FieldValue.serverTimestamp();await db.collection('tracks').doc(id).update(payload);}else{payload.created_at=firebase.firestore.FieldValue.serverTimestamp();await db.collection('tracks').add(payload);}
    showNotice('formNotice',id?'Изменения сохранены.':'Трек опубликован!','ok');$('trackForm').reset();$('artist').value='Temagas';$('editId').value='';editingCoverData='';$('saveBtn').textContent='ОПУБЛИКОВАТЬ ТРЕК';$('cancelEdit').hidden=true;await loadTracks();
  }catch(err){showNotice('formNotice','Не удалось сохранить: '+err.message,'error');}finally{btn.disabled=false;if(btn.textContent==='СОХРАНЯЕМ…')btn.textContent='ОПУБЛИКОВАТЬ ТРЕК';}});
  function startEdit(id){const t=tracks.find(x=>x.id===id);if(!t)return;$('editId').value=t.id;$('title').value=t.title||'';$('artist').value=t.artist||'';$('releaseName').value=t.release_name||'';$('coverUrl').value=t.cover_url||'';$('youtubeUrl').value=t.youtube_url||'';$('spotifyUrl').value=t.spotify_url||'';$('otherUrl').value=t.other_url||'';$('otherLabel').value=t.other_label||'';$('lyrics').value=t.lyrics||'';editingCoverData=t.cover_data||'';$('saveBtn').textContent='СОХРАНИТЬ ИЗМЕНЕНИЯ';$('cancelEdit').hidden=false;$('adminPanel').scrollIntoView({behavior:'smooth'});}
  $('cancelEdit').addEventListener('click',()=>{$('trackForm').reset();$('artist').value='Temagas';$('editId').value='';editingCoverData='';$('saveBtn').textContent='ОПУБЛИКОВАТЬ ТРЕК';$('cancelEdit').hidden=true;hideNotice('formNotice');});
  async function deleteTrack(id){const t=tracks.find(x=>x.id===id);if(!t||!confirm(`Удалить «${t.title}»?`))return;try{await db.collection('tracks').doc(id).delete();await loadTracks();}catch(e){alert('Не удалось удалить: '+e.message);}}
  function openSong(id){const t=tracks.find(x=>x.id===id);if(!t)return;const type=groupedTracks()[releaseKey(t)];const cover=coverSource(t);const links=externalLinks(t);$('songContent').innerHTML=`<div class="eyebrow">${type} · TEMAGAS</div><div class="cover">${cover?`<img src="${escapeHTML(cover)}" alt="Обложка">`:'<span class="cover-mark">T.</span>'}</div><h2 id="songTitle">${escapeHTML(t.title)}</h2><div class="artist">${escapeHTML(t.artist||'')}</div><div class="links" style="margin-top:14px">${links.map(([label,url])=>`<a href="${escapeHTML(url)}" target="_blank" rel="noopener noreferrer">Открыть ${escapeHTML(label)}</a>`).join('')}</div><div class="lyrics">${escapeHTML(t.lyrics||'Текст пока не добавлен.')}</div>`;$('songModal').classList.add('show');}
  $('trackGrid').addEventListener('click',e=>{const edit=e.target.closest('[data-edit]');const del=e.target.closest('[data-delete]');const open=e.target.closest('[data-open]');if(edit)startEdit(edit.dataset.edit);else if(del)deleteTrack(del.dataset.delete);else if(open)openSong(open.dataset.open);});
  $('searchInput').addEventListener('input',e=>{currentQuery=e.target.value.trim();render();});$('searchBtn').addEventListener('click',()=>{currentQuery=$('searchInput').value.trim();render();});
  document.querySelectorAll('[data-kind]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('[data-kind]').forEach(x=>x.classList.remove('active'));b.classList.add('active');currentKind=b.dataset.kind;render();}));
  document.querySelectorAll('nav [data-filter]').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('nav [data-filter]').forEach(x=>x.classList.remove('active'));b.classList.add('active');currentNav=b.dataset.filter;if(currentNav==='artists')currentKind='all';render();$('collection').scrollIntoView({behavior:'smooth'});}));
  $('year').textContent=new Date().getFullYear();
  if(auth){auth.onAuthStateChanged(async user=>{refreshOwner(user);await loadTracks();});}else{refreshOwner(null);loadTracks();}
